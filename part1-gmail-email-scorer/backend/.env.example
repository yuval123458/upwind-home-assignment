# Anthropic Claude API key for the LLM signal
ANTHROPIC_API_KEY=

# Google Safe Browsing Lookup API v4 key
SAFE_BROWSING_API_KEY=

# Google Cloud OAuth client ID (the add-on's project) — used to verify Google ID tokens from the add-on
GOOGLE_CLIENT_ID=

# SQLite path
DATABASE_URL=sqlite:///./scorer.db

# Environment: development | production
ENV=development
