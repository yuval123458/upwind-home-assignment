# Server
PORT=3001
LOG_LEVEL=info

# CORS — origin where the frontend runs
FRONTEND_ORIGIN=http://localhost:5173

# Session signing secret (used for HMAC-tagging opaque session tokens)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# SQLite path (relative to backend/)
DATABASE_PATH=./penguwave.db

# Initial admin user seeded on first startup (change in production!)
ADMIN_EMAIL=admin@penguwave.local
ADMIN_PASSWORD=
